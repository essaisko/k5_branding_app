rules_version = '2';

// Cloud Storage 보안 규칙
service firebase.storage {
  match /b/{bucket}/o {
    // 프로필 이미지 업로드 규칙 (테스트용 - 임시로 모든 인증된 사용자 허용)
    match /profile_images/{userId}/{imageFile} {
      // 인증된 사용자만 접근 가능 (임시 설정)
      allow read, write: if request.auth != null;
    }
    
    // 팀 헤더 이미지 업로드 규칙 (관리자만)
    match /team_images/{teamId}/{imageId} {
      // 인증된 사용자만 읽기 가능, 관리자만 쓰기 가능 (추후 팀 관리자 권한 확인 로직 추가)
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    
    // 기본적으로 모든 다른 파일은 접근 거부
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
} 